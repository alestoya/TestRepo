                {
                  "id": "551d7468-9e0e-4e0f-902f-7557656fcb77",
                  "title": "Damaging the file system",
                  "status": "Mitigated",
                  "severity": "Medium",
                  "type": "Elevation of privilege",
                  "description": "A person can commit code that when executed to perform malicious action on the server\n\nhttps://nvd.nist.gov/vuln-metrics/cvss/v3-calculator?vector=AV:N/AC:H/PR:H/UI:N/S:U/C:N/I:H/A:L&version=3.1",
                  "mitigation": "- Privilege escalation is disabled\n- Most of the capabilities of the file system are blocked for users\n- Certain namespaces related to reflection, diagnostics, threading and http are not allowed",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 1,
                  "score": "5"
                },
                {
                  "id": "4ae79ad6-04b4-4872-94dd-5aec34a1a4c8",
                  "title": "DDoS attack",
                  "status": "Mitigated",
                  "severity": "Medium",
                  "type": "Denial of service",
                  "description": "Creating multiple requests to overload the server\n\nhttps://nvd.nist.gov/vuln-metrics/cvss/v3-calculator?vector=AV:N/AC:H/PR:N/UI:N/S:U/C:N/I:N/A:H&version=3.1",
                  "mitigation": "The server is not available publicly, it can be accessed only via the code editor\nThere is a whitelist of domains that can use the parsing mechanism\nThere is a rate limiter also implemented\nThere is a reverse proxy implemented",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 11,
                  "score": "5.9"
                },
                {
                  "id": "67d79518-453e-4ec7-a887-9eef0babb5be",
                  "title": "Attaching a mining script",
                  "status": "Mitigated",
                  "severity": "Medium",
                  "type": "Denial of service",
                  "description": "Someone tries to attach a crypto mining script to leverage machine resources\n\nhttps://nvd.nist.gov/vuln-metrics/cvss/v3-calculator?vector=AV:N/AC:H/PR:N/UI:N/S:U/C:N/I:N/A:H&version=3.1",
                  "mitigation": "Processes are being looked at and killed, everything is in a container and can not access the outside networks.\nThis is a closed box and only certain domains can call this part",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 14,
                  "score": "6"
                },
                {
