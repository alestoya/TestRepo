          },
          {
            "id": "8d8ccbf3-bf9d-4d91-b09a-2cd04751c002",
            "title": "Token Header Stripping",
            "status": "Mitigated",
            "severity": "Medium",
            "type": "Tampering",
            "number": 2,
            "score": "5.3",
            "description": "Requests could be sent without RequestVerificationToken header.",
            "mitigation": "Server-side ValidateAntiForgeryToken rejects missing or invalid tokens on protected endpoints.",
            "modelType": "Threat"
          }
        ]
